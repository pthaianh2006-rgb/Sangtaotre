# Copy to .env only for local development. Never commit real secrets.
ACL_SECRET_KEY=replace-with-a-long-random-secret
ACL_ADMIN_USERNAME=admin
ACL_ADMIN_PASSWORD=replace-with-a-password-at-least-10-characters
ACL_HOST=127.0.0.1
ACL_PORT=5000
ACL_DEBUG=0
ACL_ENABLE_HARDWARE=1
ACL_CAMERA_SOURCE=1
ACL_USE_IMU=1
ACL_IMU_MODE=serial
ACL_IMU_PORT=COM8
ACL_IMU_BAUD=115200
