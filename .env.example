# Reference configuration. Set these as environment variables before startup.
# Never commit real passwords, tokens or database connection strings.
ACL_SECRET_KEY=replace-with-a-long-random-secret
ACL_ADMIN_USERNAME=admin
ACL_ADMIN_PASSWORD=replace-with-a-password-at-least-10-characters
ACL_HOST=127.0.0.1
ACL_PORT=5001
ACL_DEBUG=0
ACL_ENABLE_HARDWARE=1
ACL_CAMERA_SOURCE=Camo
ACL_CAMERA_WIDTH=1920
ACL_CAMERA_HEIGHT=1080
ACL_CAMERA_FPS=30
ACL_USE_IMU=1
ACL_IMU_MODE=ble
ACL_BLE_NAME=KneeROM_7C0A7C
ACL_IMU_HOST=192.168.4.1
ACL_IMU_TCP_PORT=8080
ACL_IMU_PORT=COM8
ACL_IMU_BAUD=115200
# Optional PostgreSQL. Omit for an explicitly configured local SQLite setup.
# ACL_DATABASE_URL=postgresql://kneerom:change-me@127.0.0.1:5432/kneerom
